==== if 顶层
源程序:  (if a b c)
编译输出: (if a b c)
目标运行: 打印 ""  结果 (error "a: undefined;\n cannot reference an identifier before its definition\n  in module: top-level")
直接运行: 打印 ""  结果 (error "a: undefined;\n cannot reference an identifier before its definition\n  in module: top-level")

==== if 在 add1 下
源程序:  (add1 (if a b c))
编译输出: (if a (add1 b) (add1 c))
目标运行: 打印 ""  结果 (error "a: undefined;\n cannot reference an identifier before its definition\n  in module: top-level")
直接运行: 打印 ""  结果 (error "a: undefined;\n cannot reference an identifier before its definition\n  in module: top-level")

==== if 在 f 下
源程序:  (f (if a b c))
编译输出: ((λ (k.0) (if a (k.0 b) (k.0 c))) (λ (v.1) ((f v.1) values)))
目标运行: 打印 ""  结果 (error "a: undefined;\n cannot reference an identifier before its definition\n  in module: top-level")
直接运行: 打印 ""  结果 (error "f: undefined;\n cannot reference an identifier before its definition\n  in module: top-level")

==== lambda 链
源程序:  (λ (n) (f (g n)))
编译输出: (λ (n) (λ (k.0) ((g n) (λ (v.1) ((f v.1) k.0)))))
目标运行: 打印 ""  结果 (value #<procedure>)
直接运行: 打印 ""  结果 (value #<procedure>)

==== 999
源程序:  (reset (let ((f (λ (x) (shift k 999)))) (add1 (f 42))))
编译输出: ((λ (f) ((f 42) add1)) (λ (x) (λ (k.0) ((λ (k) 999) k.0))))
目标运行: 打印 ""  结果 (value 999)
直接运行: 打印 ""  结果 (value 999)

==== abort 一等值
源程序:  (reset (let ((f abort)) (+ 1 (f 5))))
编译输出: ((λ (f) ((f 5) (λ (v.1) (+ 1 v.1)))) (λ (v) (λ (k.0) v)))
目标运行: 打印 ""  结果 (value 5)
直接运行: 打印 ""  结果 (value 5)

==== let/cc
源程序:  (let ((k (reset (let ((x (let/cc k (abort k)))) (+ x 2))))) (+ (reset (k 3)) 100))
编译输出: ((λ (k) (+ ((k 3) values) 100)) ((λ (k.0) (λ (v.0) (λ (k.1) (k.0 v.0)))) (λ (x) (+ x 2))))
目标运行: 打印 ""  结果 (value 105)
直接运行: 打印 ""  结果 (value 105)

==== 例1
源程序:  (let ((v (reset (let* ((x 3) (y (+ 2 x))) (abort y))))) (+ 10 v))
编译输出: ((λ (v) (+ 10 v)) ((λ (x) (+ 2 x)) 3))
目标运行: 打印 ""  结果 (value 15)
直接运行: 打印 ""  结果 (value 15)

==== 例2
源程序:  (let ((v (reset (let* ((x (shift k 3)) (y (+ 2 x))) (abort y))))) (+ 10 v))
编译输出: ((λ (v) (+ 10 v)) ((λ (k) 3) (λ (x) (+ 2 x))))
目标运行: 打印 ""  结果 (value 13)
直接运行: 打印 ""  结果 (value 13)

==== 例3
源程序:  (let ((v (reset (let* ((x (shift k (k 3))) (y (+ 2 x))) (abort y))))) (+ 10 v))
编译输出: ((λ (v) (+ 10 v)) ((λ (k) (k 3)) (λ (x) (+ 2 x))))
目标运行: 打印 ""  结果 (value 15)
直接运行: 打印 ""  结果 (value 15)

==== 例4
源程序:  (let ((v (reset (let* ((x (shift k (let ((r (k 3))) (k r)))) (y (+ 2 x))) (abort y))))) (+ 10 v))
编译输出: ((λ (v) (+ 10 v)) ((λ (k) (k (k 3))) (λ (x) (+ 2 x))))
目标运行: 打印 ""  结果 (value 17)
直接运行: 打印 ""  结果 (value 17)

==== 阴阳 label 版
源程序:  (reset (let* ((label (λ () (let/lc k k))) (yin (label)) (_ (display #\@)) (yang (label)) (_ (display #\*))) (yin yang)))
编译输出: ((λ (label) ((label) (λ (yin) ((λ (_) ((label) (λ (yang) ((λ (_) ((yin yang) values)) (display #\*))))) (display #\@))))) (λ () (λ (k.0) ((λ (k) (k k)) k.0))))
目标运行: 打印 "@*@**@***@****@*****@******@*******@****..."  结果 (killed "（未结束，已截断）")
直接运行: 打印 "@*@**@***@****@*****@******@*******@****..."  结果 (killed "（未结束，已截断）")

==== id 裸延续
源程序:  (let ((id (reset (shift k k)))) (id (id 3)))
编译输出: ((λ (id) ((id 3) (λ (v.2) ((id v.2) values)))) values)
目标运行: 打印 ""  结果 (error "application: not a procedure;\n expected a procedure that can be applied to arguments\n  given: 3")
直接运行: 打印 ""  结果 (value 3)

==== id 包装
源程序:  (let ((id (reset (shift k (λ (v) (k v)))))) (id (id 3)))
编译输出: ((λ (id) ((id 3) (λ (v.3) ((id v.3) values)))) ((λ (k) (λ (v) (λ (k.0) (k.0 (k v))))) values))
目标运行: 打印 ""  结果 (value 3)
直接运行: 打印 ""  结果 (value 3)

==== 阴阳 包装版
源程序:  (reset (let* ((kn (let/lc k0 (λ (v) (k0 v)))) (_ (display #\@)) (k (let/lc kn+1 (λ (v) (kn+1 v)))) (_ (display #\*))) (kn k)))
编译输出: ((λ (k0) (k0 (λ (v) (λ (k.0) (k.0 (k0 v)))))) (λ (kn) ((λ (_) ((λ (kn+1) (kn+1 (λ (v) (λ (k.1) (k.1 (kn+1 v)))))) (λ (k) ((λ (_) ((kn k) values)) (display #\*))))) (display #\@))))
目标运行: 打印 "@*@**@***@****@*****@******@*******@****..."  结果 (killed "（未结束，已截断）")
直接运行: 打印 "@*@**@***@****@*****@******@*******@****..."  结果 (killed "（未结束，已截断）")

