(((define ((∘ℒ g* ... f) . x*)
  (foldr append-map (apply f x*) g*))
"参数表 g* ... f 是示意写法，Racket 的剩余参数只能放在最后；code.rkt 用 split-at-right 取出最右边的箭头")
 ((define ((betweenᵒ l h a) s)
  `([,a . ,(between (value-of l s) (value-of h s))] . ,s))
"5.4.3 先手写具体版本，随后抽象为 (function->relation between)")
 ((define ((pythᵒ a b c) s)
  (check (pyth? (value-of a s) (value-of b s) (value-of c s)))
  s)
"5.4.3 先手写具体版本，随后抽象为 (predicate->relation pyth?)")
 ((define ((betweenᵒ l h a) s)
  (unify a (between (value-of l s) (value-of h s)) s))
"5.5.3 先手写基于合一的 betweenᵒ 与旧版对比，随后再抽象为 function->relation")
 ((define-syntax-rule (conde [g ...] ...)
  (∨ (∧ g ...) ...))
"5.5.4 展示 miniKanren 表面语法糖")
 ((define-syntax-rule (run* (x ...) g ...)
  (let ([x (var 'x)] ...)
    (in-amb
     (let ([s ((∧ g ...) '())])
       (list (value-of x s) ...)))))
"5.5.4 扩展 5.4.2 的单目标 run* 为自动合取多目标的版本")
 ((define-syntax-rule (fresh (x ...) g ...)
  (∃ (x ...) (∧ g ...)))
"5.5.4 借 ∃ 定义自动合取的 fresh 语法糖")
 ((define (appendᵒ l t out)
  (conde
   [(≡ l '()) (≡ t out)]
   [(fresh (a d res)
      (≡ l (cons a d))
      (≡ out (cons a res))
      (appendᵒ d t res))]))
"5.5.4 用 run*/fresh/conde 重写 appendᵒ 展示表面语法"))
