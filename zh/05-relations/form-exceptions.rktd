(((define ((∘ℒ g* ... f) . x*)
  (foldr append-map (apply f x*) g*))
"参数表 g* ... f 是示意写法，Racket 的剩余参数只能放在最后；code.rkt 用 split-at-right 取出最右边的箭头")
 ((: empty-s Substitution)
"4.2 与附录用 empty-s 表示空代换，避免正文裸写 '()")
 ((define empty-s '())
"4.2 与附录用 empty-s 表示空代换，避免正文裸写 '()")
 ((: size-s (→ Substitution Natural))
"4.2 与附录补上 size-s 封装代换长度")
 ((define (size-s s) (length s))
"4.2 与附录补上 size-s 封装代换长度")
 ((define (ext-s x t s) (cons (cons x t) s))
"4.2 先给出不含循环检查的极简 ext-s，附录与 code.rkt v2 补上 occurs? 检查")
 ((define s (ext-s a 3 empty-s))
"4.2 REPL 示例用 ext-s 与 empty-s 构造测试代换")
 ((define s (ext-s x y (ext-s y 5 empty-s)))
"5.3 REPL 示例用 ext-s 与 empty-s 构造链式代换")
 ((define-syntax-rule (run* (x ...) g)
  (let ([x (var 'x)] ...)
    (in-amb
     (let ([s (g empty-s)])
       (list (value-of x s) ...)))))
"4.2 极简版 run* 使用 empty-s，6.3 与附录升级为标准 run 与 run*")
 ((define ((betweenᵒ l h a) s)
  (ext-s a (between (value-of l s) (value-of h s)) s))
"5.4.3 先手写具体版本，随后抽象为 (function->relation between)")
 ((define ((pythᵒ a b c) s)
  (check (pyth? (value-of a s) (value-of b s) (value-of c s)))
  s)
"5.4.3 先手写具体版本，随后抽象为 (predicate->relation pyth?)")
 ((define (((function->relation f) . t*) s)
  (define-values (in* out*) (split-at-right t* 1))
  (ext-s (car out*) (apply f (for/list ([t in*]) (value-of t s))) s))
"5.4.3 极简版 function->relation 使用 ext-s，5.5.3 升级为 unify")
 ((define ((betweenᵒ l h a) s)
  (unify a (between (value-of l s) (value-of h s)) s))
"5.5.3 先手写基于合一的 betweenᵒ 与旧版对比，随后再抽象为 function->relation")
 ((define-syntax-rule (run n (x ...) g ...)
  (let ([limit n])
    (let ([x (var 'x)] ...)
      (define ans*
        (in-amb (reify (walk* (list x ...) ((∧ g ...) empty-s)))))
      (if limit (take ans* (min limit (length ans*))) ans*))))
"6.3 与附录引入标准 (run n ...) 表面语法")
 ((define-syntax-rule (condᵉ [g ...] ...)
  (∨ (∧ g ...) ...))
"6.3 与附录展示 miniKanren 表面语法糖")
 ((define-syntax-rule (fresh (x ...) g ...)
  (∃ (x ...) (∧ g ...)))
"6.3 与附录借 ∃ 定义自动合取的 fresh 语法糖")
 ((define (appendᵒ l t out)
  (condᵉ
   [(≡ l '()) (≡ t out)]
   [(fresh (a d res)
      (≡ l (cons a d))
      (≡ out (cons a res))
      (appendᵒ d t res))]))
"6.3 用 run/fresh/condᵉ 重写 appendᵒ 展示表面语法"))
